  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "firebase": "^11.6.1",
    "playwright": "^1.56.1"
  }
}
