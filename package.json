  "description": "نظام إدارة الالتزام (CMS) — فحوص الجودة والاختبارات الآلية",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
