rules_version = '2';

// قواعد أمان نظام إدارة الالتزام (CMS)
// القراءة: أي مستخدم مسجَّل دخول
// الكتابة: حسب الدور في وثيقة users/{uid}:
//   ADMIN / COMPLIANCE_MANAGER / SPECIALIST — تحرير كامل للمحتوى
//   DEPT_OWNER — تحديث الفحص الذاتي والملاحظات الخاصة بإدارته فقط
//   AUDITOR / EXECUTIVE — قراءة فقط
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRoleDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      // توافق مع الوثائق القديمة بصيغة compliance_manager
      return hasRoleDoc() ? me().role.upper() : 'AUDITOR';
    }

    function isEditor() {
      return signedIn() && myRole() in ['ADMIN', 'COMPLIANCE_MANAGER', 'SPECIALIST'];
    }

    function isApprover() {
      return signedIn() && myRole() in ['ADMIN', 'COMPLIANCE_MANAGER'];
    }

    function isDeptOwnerOf(deptId) {
      return signedIn() && myRole() == 'DEPT_OWNER' && hasRoleDoc() && me().departmentId == deptId;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isApprover();
    }

    match /departments/{id} {
      allow read: if signedIn();
      allow write: if isApprover();
    }

    match /authorities/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /requirements/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /risks/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /monitoring/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /planItems/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /assessments/{id} {
      allow read: if signedIn();
      allow create, delete: if isEditor();
      // مالك الإدارة يجيب على فحص إدارته (تحديث الأسئلة والتعليق والإرسال للمراجعة)
      allow update: if isEditor() || isDeptOwnerOf(resource.data.departmentId);
    }

    match /correspondence/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /disclosures/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /trainings/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /directory/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    // تقييم نضج التجمعات: مسؤول التزام التجمع يقيّم تجمعه، والمحرر (الشركة) يراجع
    match /maturity/{id} {
      allow read: if signedIn();
      allow create, update: if isEditor() || (signedIn() && myRole() == 'CLUSTER_OFFICER');
      allow delete: if isEditor();
    }

    match /meetings/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /regChanges/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    // ---------- الرصد التنظيمي وإدارة التغيير ----------
    // مصادر الرصد: يقرأها كل مسجَّل، ويحرّرها المحرر فقط
    match /regSources/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    // المستجدات التنظيمية المرصودة: التحرير للمحرر، أما الاعتماد (الانتقال إلى APPROVED)
    // فمقصور على المعتمِد — بحيث لا يستطيع أخصائي الالتزام دمج مستجد في وحدات النظام
    match /regUpdates/{id} {
      allow read: if signedIn();
      allow create: if isEditor();
      allow update: if isEditor() &&
        (request.resource.data.status != 'APPROVED'
          || resource.data.status == 'APPROVED'
          || isApprover());
      allow delete: if isApprover();
    }

    // سجل عمليات الفحص: تكتبه دوال الخادم (تتجاوز القواعد)، ويُنشئه المعتمِد يدوياً
    match /regScans/{id} {
      allow read: if signedIn();
      allow create, update: if isApprover();
      allow delete: if false;
    }

    // التقارير الأسبوعية للرصد التنظيمي
    match /regReports/{id} {
      allow read: if signedIn();
      allow create, update: if isEditor();
      allow delete: if isApprover();
    }

    // مسارات الاعتماد وسير العمل — الأدوار مفروضة في الواجهة، والكتابة للمحرر
    match /workflows/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    // التدقيق الداخلي وأوراق العمل والتقارير المعتمدة
    match /audits/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /findings/{id} {
      allow read: if signedIn();
      allow create, delete: if isEditor();
      // مالك الإدارة يحدّث تقدم الإجراءات التصحيحية لملاحظات إدارته
      allow update: if isEditor() || isDeptOwnerOf(resource.data.departmentId);
    }

    match /counters/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    match /reports/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isApprover();
    }

    match /notifications/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      // تعليم كمقروء فقط لغير المحررين
      allow update: if isEditor() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isApprover();
    }

    // إعدادات النظام العامة (عتبات التنبيهات، مستهدفات المؤشرات…) — يحرّرها المحرر
    match /appConfig/{id} {
      allow read: if signedIn();
      allow write: if isEditor();
    }

    // اللقطات اليومية لمؤشرات اللوحة التنفيذية — يلتقطها المحرر، ولا تُحذف
    match /metricSnapshots/{id} {
      allow read: if signedIn();
      allow create, update: if isEditor();
      allow delete: if isApprover();
    }

    // طابور البريد لإضافة Firebase «Trigger Email» — إنشاء فقط من التطبيق،
    // والإضافة تُحدّث حقل delivery بصلاحيات المدير خارج هذه القواعد
    match /mail/{id} {
      allow read: if isApprover();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // سجل التدقيق: إنشاء فقط — لا تعديل ولا حذف (Audit Trail غير قابل للعبث)
    match /auditLog/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /regulations/{regId} {
      allow read: if signedIn();
      allow write: if isEditor();

      match /articles/{articleId} {
        allow read: if signedIn();
        allow write: if isEditor();
      }
    }
  }
}
